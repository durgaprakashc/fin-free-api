{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN:your-github-personal-access-token}"
      }
    },
    "atlassian": {
      "command": "npx",
      "args": ["-y", "@xuandev/atlassian-mcp"],
      "env": {
        "ATLASSIAN_DOMAIN": "${ATLASSIAN_SITE_URL:your-site.atlassian.net}",
        "ATLASSIAN_EMAIL": "${ATLASSIAN_USER_EMAIL:your-email@example.com}",
        "ATLASSIAN_API_TOKEN": "${ATLASSIAN_API_TOKEN:your-atlassian-api-token}"
      }
    }
  }
}